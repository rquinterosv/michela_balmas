# Copia este archivo como server/.env y ajusta los valores.
# Tal como está, sirve para desarrollo local con los emuladores.

# Puerto del backend.
PORT=3001

# Orígenes permitidos por CORS, separados por coma (sin barra final).
# Producción: https://www.tusitio.it
CORS_ORIGINS=http://localhost:5173

# --- Firebase ---
# ID del proyecto. Un ID que empieza por "demo-" solo existe en los emuladores,
# así que es imposible tocar producción por error.
FIREBASE_PROJECT_ID=demo-studio

# Emuladores (solo desarrollo). En producción, BORRA estas dos líneas.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Service account (solo producción). Salen del JSON que descarga la consola de
# Firebase: campos "client_email" y "private_key". La clave va entre comillas,
# en una sola línea, con los \n tal cual.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Formulario de contacto ---
# Máximo de envíos por IP cada 15 minutos.
CONTACT_RATE_LIMIT_MAX=5

# --- Aviso por email de cada mensaje nuevo (opcional, desactivado por defecto) ---
EMAIL_NOTIFICATIONS_ENABLED=false
# API key de Resend (https://resend.com).
RESEND_API_KEY=
# Quién recibe el aviso (la psicóloga).
NOTIFY_EMAIL_TO=
# Remitente: debe ser de un dominio verificado en Resend.
NOTIFY_EMAIL_FROM=
