# Copia este archivo como client/.env y ajusta los valores.
# Tal como está, sirve para desarrollo local con los emuladores.
# Ojo: todo lo que empieza por VITE_ acaba en el JavaScript público. Nada secreto aquí.

# URL del backend. Vacío en desarrollo: Vite redirige /api a http://127.0.0.1:3001.
# Producción: https://tu-backend.onrender.com (sin barra final).
VITE_API_URL=

# URL pública del sitio, para los metadatos SEO / Open Graph.
VITE_SITE_URL=http://localhost:5173

# "true" = el login del panel usa el emulador de Auth. En producción: false.
VITE_USE_EMULATORS=true

# --- Firebase (consola > Configuración del proyecto > Tus apps > App web) ---
# Con los emuladores valen estos valores de ejemplo.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-studio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-studio
VITE_FIREBASE_APP_ID=
